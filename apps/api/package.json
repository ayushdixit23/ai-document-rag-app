{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "lint": "eslint --max-warnings 0 --cache --cache-location node_modules/.cache/eslint",
    "lint:fix": "eslint --fix",
    "check-types": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:clear": "tsx src/scripts/clear.ts"
  },
  "prettier": "@repo/prettier-config",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Express + Drizzle PostgreSQL + TypeScript starter - api",
  "devDependencies": {
    "@react-email/ui": "6.9.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/prettier-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.0.0",
    "@types/node": "^22.15.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/sanitize-html": "^2.16.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.1",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.7.4",
    "rimraf": "^6.1.0",
    "tsx": "^4.21.0",
    "typescript": "5.9.2"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@langchain/classic": "1.0.55",
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.3.0",
