# Server Configuration
PORT=5001
NODE_ENV=development

# PostgreSQL (Neon or any Postgres). Use the pooler URL in serverless/dev.
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
# Direct (non-pooler) Neon URL for pg-boss maintenance and polling.
DATABASE_URL_DIRECT=postgresql://user:password@direct-host/neondb?sslmode=require
DATABASE_POOL_MAX=10
# Opt in after verifying support (current Neon PgBouncer supports protocol preparation).
DATABASE_PREPARE_STATEMENTS=false

# Cloudflare R2 private bucket and S3 API token.
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET_NAME=your-bucket-name

# Google Generative AI (required for RAG models)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_FAST_MODEL=gemini-2.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
# Background input allowance per minute; leave room for queries under a 100-input quota.
GEMINI_EMBED_INPUTS_PER_MINUTE=96

# Hybrid retrieval + Pinecone reranking (optional key; local BM25 fallback if unavailable).
RAG_RETRIEVAL_MODE=hybrid_rerank
PINECONE_API_KEY=
# Keep stable across API processes/key rotations. Shared database enforces 500 calls / 31 days.
PINECONE_RERANK_BUDGET_SCOPE=askdocs-bge-reranker-v2-m3

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=400

# Better Auth (required)
# Generate secret: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
# Public auth URL = web origin (Next rewrites /api/* → Express so cookies are first-party)
BETTER_AUTH_URL=http://localhost:3000
WEB_URL=http://localhost:3000

# Google OAuth (optional — enable Google login when both are set)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# Also set NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true in apps/web
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend (required for email verification)
# https://resend.com/api-keys — use an address on your verified domain
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=AskDocs <ayush@ayushdixit.me>
